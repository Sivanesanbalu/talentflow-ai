# Copy to .env.local for development; never commit real credentials.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret-in-local-env

# Optional AI follow-up questions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional invitation/reminder email delivery
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# Required to authorize scheduled cron HTTP endpoints
CRON_SECRET=
